PORT=8000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/taxgenie
MONGO_URI=mongodb://localhost:27017/taxgenie

# JWT Secrets & Expiries
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_32chars
JWT_SECRET=your_jwt_access_secret_super_secure_key_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookie & Origin
COOKIE_DOMAIN=localhost
CLIENT_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Email Service (Mailtrap or SMTP in development, or Resend)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=TaxGenie <no-reply@taxgenie.in>

# Optional Integrations
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here

